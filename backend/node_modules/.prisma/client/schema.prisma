generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model WorkItem {
  id                  String    @id @default(uuid())
  component_id        String
  status              String    @default("OPEN")
  severity            String
  start_time          DateTime
  end_time            DateTime?
  mttr                Float?
  rca                 String?
  root_cause_category String?
  fix_applied         String?
  prevention_steps    String?
}
